# secrets — never commit (cullroom rule: this file lands before the first token is minted)
.env
*.env
popfleet.env

# local state (JSON store lives next to the binary)
popfleet.json
*.json.tmp

# build artifacts
/popfleet
/popfleet-*

# tooling noise
.omc/
.claude/

# python bytecode (agent.py is a plain script; nothing here is source)
__pycache__/
*.pyc

# AgentOps session artifacts
/.agents/

# worker tooling (secrets in .dev.vars, wrangler cache, deps)
worker/.dev.vars
worker/.wrangler/
worker/node_modules/
